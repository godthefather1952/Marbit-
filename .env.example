# ============================================================================
# Polymarket US (polymarket.us) - CFTC-regulated US exchange
# Used by: check_us_account.py, polymarket_us.py   (READ-ONLY, cannot trade)
# Get keys at polymarket.us/developer
# ============================================================================
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# ============================================================================
# Polymarket global (polymarket.com) - the venue btc_polymarket_arb.py trades.
# A SEPARATE exchange from Polymarket US. Credentials are NOT interchangeable,
# and US-only accounts cannot access it.
# ============================================================================
# Polymarket credentials. Copy to `.env` and fill in.
# `.env` is gitignored - NEVER commit a real private key.

# --- Level 1 auth: signing (required for --live) ---
# Polygon wallet private key, 0x-prefixed.
POLYMARKET_PK=0x...

# --- Level 2 auth: order posting (optional) ---
# If left blank, the bot derives these from POLYMARKET_PK on startup.
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# --- Wallet topology ---
# 0 = EOA: the key above directly holds the USDC (default)
# 1 = Polymarket email/magic proxy wallet
# 2 = Polymarket browser-wallet proxy
POLYMARKET_SIGNATURE_TYPE=0

# Required for signature types 1 and 2: the proxy address holding the USDC.
# Leave blank for type 0.
POLYMARKET_FUNDER=

# --- Low-latency infrastructure (optional) ---
# Private Polygon RPC (Alchemy / QuickNode / Chainstack). When set, USDC balance
# and allowance are read straight from chain instead of via the Polymarket API -
# faster, and independent of Polymarket's own uptime.
POLYGON_RPC_URL=

# Websocket RPC endpoint. Plumbed through and validated for on-chain
# subscriptions; the trading path is REST-only today and does not use it.
POLYGON_WS_URL=
